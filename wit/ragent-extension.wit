package ragent:extension@1.0.0;

interface host {
    manage-process: func(request-json: string) -> string;
}

interface lifecycle {
    metadata: func() -> string;
    initialize: func(config: string) -> result<_, string>;
    invoke: func(request: string) -> result<string, string>;
    shutdown: func();
}

world plugin {
    import host;
    export lifecycle;
}
